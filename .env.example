# ============================================
# SHIPINFY METRICS — Variables d'environnement
# metrics.mediflows.shop
# ============================================

# --- Base de données (Supabase) ---
# Utiliser Transaction Pooler (port 6543) pour Prisma
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# --- Email (Nodemailer SMTP ou Resend) — Sprint 16 ---
SMTP_PROVIDER="smtp"          # "smtp" | "resend"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="votre@email.com"
SMTP_PASS="votre-mot-de-passe-app"
SMTP_FROM="Shipinfy Metrics <noreply@shipinfy.com>"
SMTP_TEST_TO="admin@shipinfy.com"   # destinataire du GET /api/debug/email-test
RESEND_API_KEY=""              # requis si SMTP_PROVIDER=resend

# --- QR Pointage (Sprint 16) ---
QR_SECRET="shipinfy-dev-secret"     # valeur forte obligatoire en production

# --- WhatsApp plannings (Sprint 16) ---
WHATSAPP_PROVIDER=""          # "twilio" | "meta" | vide (désactivé)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
META_WHATSAPP_PHONE_ID=""
META_WHATSAPP_TOKEN=""
SHIFT_REMINDER_MINUTES="30"   # rappel shift non ouvert

# --- API Back-office (optionnel — Mode demo si absent) ---
# BACKOFFICE_API_URL="https://api.mediflows.shop"
# BACKOFFICE_API_KEY="votre-cle-api"

# --- Next.js ---
NEXTAUTH_URL="https://metrics.mediflows.shop"
NODE_ENV="production"
