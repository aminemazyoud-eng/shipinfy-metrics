# ============================================
# SHIPINFY METRICS — Variables d'environnement
# metrics.mediflows.shop
# ============================================

# --- Base de données (Supabase) ---
# Utiliser Transaction Pooler (port 6543) pour Prisma. connection_limit=5&pool_timeout=20 : 5 connexions max par instance, 20 s d'attente avant erreur
# (connection_limit=1 saturait l'app dès 2 requêtes simultanées).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"

# --- Email (Nodemailer SMTP ou Resend) — Sprint 16 ---
SMTP_PROVIDER="smtp"          # "smtp" | "resend"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="votre@email.com"
SMTP_PASS="votre-mot-de-passe-app"
SMTP_FROM="Shipinfy Metrics <noreply@shipinfy.com>"
SMTP_TEST_TO="admin@shipinfy.com"   # destinataire du GET /api/debug/email-test
RESEND_API_KEY=""              # requis si SMTP_PROVIDER=resend

# --- QR Pointage (Sprint 16) ---
QR_SECRET="change-me-long-random-string-32chars+"   # OBLIGATOIRE en production (>= 32 car.) — signe les QR de pointage

# --- Notifications (Sprint 17) ---
NOTIFY_MODE="direct"          # "direct" = l'app envoie · "n8n" = délégué à n8n (résultats via /api/webhooks/n8n)
ALERT_EMAIL_TO=""             # destinataire(s) des alertes level 3, séparés par des virgules (optionnel)
N8N_WEBHOOK_SECRET=""         # secret HMAC pour vérifier les callbacks n8n (optionnel)

# --- WhatsApp plannings (Sprint 16) ---
WHATSAPP_PROVIDER=""          # "twilio" | "meta" | "evolution" | vide (désactivé)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
META_WHATSAPP_PHONE_ID=""
META_WHATSAPP_TOKEN=""
EVOLUTION_API_URL=""           # ex: https://evo.mediflows.shop (instance Evolution API partagée Dokploy)
EVOLUTION_INSTANCE=""          # nom de l'instance Evolution API
EVOLUTION_API_KEY=""
SHIFT_REMINDER_MINUTES="30"   # rappel shift non ouvert

# --- API Back-office (optionnel — Mode demo si absent) ---
# BACKOFFICE_API_URL="https://api.mediflows.shop"
# BACKOFFICE_API_KEY="votre-cle-api"

# --- Next.js ---
NEXTAUTH_URL="https://metrics.mediflows.shop"
NODE_ENV="production"

# --- Connexion directe (migrations / run-init-sql, hors pooler) ---
DIRECT_URL="postgresql://postgres:EXEMPLE-MOT-DE-PASSE@db.EXEMPLE-REF.supabase.co:5432/postgres"

# --- Secrets applicatifs (générer chacun avec : openssl rand -hex 32) ---
PLANNING_LINK_SECRET="exemple-secret-liens-planning-pdf-0123456789abcdef"   # signe les liens PDF du planning envoyés par WhatsApp
CRON_SECRET="exemple-secret-cron-0123456789abcdef0123456789abcdef"          # en-tête x-cron-secret des tâches planifiées internes
# N8N_WEBHOOK_SECRET (section Notifications plus haut) : valeur d'exemple "exemple-secret-n8n-0123456789abcdef"

# --- URL publique & source de données ---
APP_URL="https://metrics.mediflows.shop"        # base des liens absolus (PDF planning, e-mails)
OPS_ACTIVE_SOURCE="shipinfy-bo"                 # source de commandes active : "shipinfy-bo" | "odoo" | "mock"

# --- Sorties HTTP (anti-SSRF) ---
OUTBOUND_ALLOWED_HOSTS="n8n.mediflows.shop,evo.mediflows.shop,hooks.slack.com"   # hôtes autorisés pour les appels sortants (séparés par des virgules)
N8N_HOST="n8n.mediflows.shop"                   # hôte de l'instance n8n

# --- Fuseau horaire du conteneur (déjà fixé dans le Dockerfile) ---
# TZ="Africa/Casablanca"
