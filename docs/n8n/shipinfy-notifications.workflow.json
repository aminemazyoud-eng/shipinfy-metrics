{
  "name": "Shipinfy — Notifications",
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "shipinfy-notify",
        "responseMode": "onReceived",
        "options": {
          "responseCode": 200
        }
      },
      "id": "webhook-in",
      "name": "Webhook Shipinfy",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -40,
        300
      ],
      "webhookId": "shipinfy-notify"
    },
    {
      "parameters": {
        "jsClass": "",
        "jsCode": "// Normalise le payload envoyé par lib/notify.ts / triggerN8N\nconst root = $input.first().json;\nconst body = root.body ?? root;              // selon 'Received data'\nconst d = body.data ?? {};\nconst inner = d.data ?? {};\n\nreturn [{\n  json: {\n    eventType: body.eventType ?? 'report_ready',\n    notificationId: d.notificationId ?? null,\n    kind: d.kind ?? (String(body.eventType).startsWith('alert') ? 'alert' : 'report'),\n    title: d.title ?? '(sans titre)',\n    summary: d.summary ?? '',\n    channels: d.channels ?? [],\n    recipients: Array.isArray(d.recipients) ? d.recipients : [],\n    recipientsStr: (d.recipients ?? []).join(','),\n    alertLevel: d.alertLevel ?? null,\n    reportId: d.reportId ?? null,\n    pdfFilename: d.pdfFilename ?? 'rapport.pdf',\n    pdfBase64: d.pdfBase64 ?? null,\n    metrics: inner,\n    wantsEmail: (d.channels ?? []).includes('email'),\n    wantsSlack: (d.channels ?? []).includes('slack'),\n    wantsWhatsapp: (d.channels ?? []).includes('whatsapp'),\n  },\n  binary: d.pdfBase64\n    ? { pdf: { data: d.pdfBase64, mimeType: 'application/pdf', fileName: d.pdfFilename ?? 'rapport.pdf' } }\n    : {},\n}];\n"
      },
      "id": "prep",
      "name": "Préparer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.wantsEmail }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "if-email",
      "name": "Email demandé ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        180
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $json.wantsSlack }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "if-slack",
      "name": "Slack demandé ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        440
      ]
    },
    {
      "parameters": {
        "fromEmail": "Shipinfy Metrics <noreply@shipinfy.com>",
        "toEmail": "={{ $json.recipientsStr }}",
        "subject": "={{ $json.title }}",
        "emailFormat": "text",
        "text": "={{ $json.summary }}",
        "options": {
          "attachments": "pdf"
        }
      },
      "id": "gmail",
      "name": "Email — envoyer",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        700,
        120
      ],
      "notes": "TODO: créer la credential SMTP. Gmail: host smtp.gmail.com, port 465, SSL/TLS ON, user = ton email, password = mot de passe d'application Gmail (16 car.). fromEmail à ajuster.",
      "credentials": {}
    },
    {
      "parameters": {
        "method": "POST",
        "url": "PASTE_YOUR_SLACK_INCOMING_WEBHOOK_URL_HERE",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: '🚨 *' + $json.title + '*\\n' + $json.summary }) }}",
        "options": {}
      },
      "id": "slack",
      "name": "Slack — poster",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        440
      ],
      "notes": "TODO: remplacer l'URL par ton Slack Incoming Webhook (https://hooks.slack.com/services/...). Aucun credential nécessaire.",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Sprint 17 A6 : signe le callback (HMAC-SHA256 de \"timestamp.corps\", hex) — secret = variable n8n N8N_WEBHOOK_SECRET (la même que côté Shipinfy).\n// Prérequis n8n : NODE_FUNCTION_ALLOW_BUILTIN=crypto et N8N_BLOCK_ENV_ACCESS_IN_NODE=false.\nconst crypto = require('crypto');\nconst secret = $env.N8N_WEBHOOK_SECRET;\nconst cbBody = JSON.stringify({ notificationId: $('Préparer').item.json.notificationId, channel: 'email', status: $json.error ? 'failed' : 'delivered', sentTo: $('Préparer').item.json.recipientsStr, error: $json.error ?? null });\nconst cbTs = String(Math.floor(Date.now() / 1000));\nconst cbSig = crypto.createHmac('sha256', secret).update(cbTs + '.' + cbBody).digest('hex');\nreturn { json: { ...$json, cbBody, cbTs, cbSig } };\n"
      },
      "id": "sign-email",
      "name": "Signer callback email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        120
      ]
    },
