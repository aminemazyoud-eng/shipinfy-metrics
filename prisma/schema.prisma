generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DeliveryReport {
  id               String          @id @default(cuid())
  filename         String
  uploadedAt       DateTime        @default(now())
  isActive         Boolean         @default(true)
  payValidated     Boolean         @default(false)
  payValidatedAt   DateTime?
  payValidatedBy   String?
  orders           DeliveryOrder[]
}

model ScheduledReport {
  id           String        @id @default(cuid())
  reportId     String
  emails       String
  frequency    String
  time         String
  dayOfWeek    Int?
  dayOfMonth   Int?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sendLogs     EmailSendLog[]
}

model EmailSendLog {
  id          String          @id @default(cuid())
  scheduleId  String
  schedule    ScheduledReport @relation(fields: [scheduleId], references: [id])
  sentAt      DateTime        @default(now())
  success     Boolean
  recipients  String
  error       String?
}

// ─── ALERTES & TICKETS ─────────────────────────────────────────────────────

model AlertRule {
  id        String   @id @default(cuid())
  name      String
  metric    String   // "delivery_rate" | "no_show_rate" | "on_time_rate" | "no_show_count"
  operator  String   // "lt" | "gt" | "lte" | "gte"
  threshold Float
  severity  String   @default("warning") // "critical" | "warning" | "info"
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  alerts    Alert[]
}

model Alert {
  id          String    @id @default(cuid())
  ruleId      String?
  rule        AlertRule? @relation(fields: [ruleId], references: [id])
  type        String    // "auto" | "manual"
  severity    String    // "critical" | "warning" | "info"
  title       String
  description String
  metricValue Float?
  threshold   Float?
  status      String    @default("open") // "open" | "in_progress" | "resolved"
  assignedTo  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  tickets     Ticket[]
}

model Ticket {
  id          String          @id @default(cuid())
  alertId     String?
  alert       Alert?          @relation(fields: [alertId], references: [id])
  title       String
  description String
  priority    String          @default("moyenne") // "haute" | "moyenne" | "basse"
  status      String          @default("ouvert") // "ouvert" | "en_cours" | "resolu" | "ferme"
  assignedTo  String?
  comments    TicketComment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    String
  content   String
  createdAt DateTime @default(now())
}

// ─── DELIVERY ORDERS ───────────────────────────────────────────────────────

model DeliveryOrder {
  id                          String         @id @default(cuid())
  reportId                    String
  report                      DeliveryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  externalReference           String?
  shipperReference            String?
  carrierReference            String?

  pickupTimeStart             DateTime?
  deliveryTimeStart           DateTime?
  deliveryTimeEnd             DateTime?

  dateTimeWhenOrderSent       DateTime?
  dateTimeWhenAssigned        DateTime?
  dateTimeWhenInTransport     DateTime?
  dateTimeWhenStartDelivery   DateTime?
  dateTimeWhenDelivered       DateTime?
  dateTimeWhenNoShow          DateTime?
  dateTimeLastUpdate          DateTime?

  shippingWorkflowStatus      String?
  paymentOnDeliveryAmount     Float?

  destinationFirstname        String?
  destinationLastname         String?
  destinationCityCode         String?
  destinationLongitude        Float?
  destinationLatitude         Float?

  originHubName               String?
  originHubCode               String?
  originHubCity               String?
  originHubLongitude          Float?
  originHubLatitude           Float?

  sprintName                  String?
  livreurFirstName            String?
  livreurLastName             String?
  sprintGeoLongitude          Float?
  sprintGeoLatitude           Float?

  createdAt                   DateTime @default(now())

  @@index([reportId])
  @@index([shippingWorkflowStatus])
  @@index([dateTimeWhenOrderSent])
  @@index([deliveryTimeStart])
  @@index([sprintName])
  @@index([originHubName])
}

// ─── ONBOARDING ────────────────────────────────────────────────────────────

model Driver {
  id               String           @id @default(cuid())
  firstName        String
  lastName         String
  phone            String           @unique
  email            String?
  city             String?
  role             String           @default("LIVREUR") // "LIVREUR" | "PICKER" — Sprint 16
  status           String           @default("prospect")
  // "prospect" | "en_cours" | "formation" | "valide" | "actif" | "inactif" | "rejete"
  reliabilityScore Float?
  notes            String?
  onboardingSteps  OnboardingStep[]
  courseProgress   CourseProgress[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model OnboardingStep {
  id          String    @id @default(cuid())
  driverId    String
  driver      Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  step        String
  // "kyc_identity" | "kyc_vehicle" | "contract" | "training" | "equipment"
  status      String    @default("pending")
  // "pending" | "submitted" | "validated" | "rejected"
  documentUrl String?
  notes       String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([driverId, step])
}

// ─── ACADEMY ────────────────────────────────────────────────────────────────

model Course {
  id          String           @id @default(cuid())
  title       String
  category    String
  description String
  color       String           @default("#2563eb")
  emoji       String           @default("📚")
  order       Int              @default(0)
  lessons     Lesson[]
  progress    CourseProgress[]
  createdAt   DateTime         @default(now())
}

model Lesson {
  id         String         @id @default(cuid())
  courseId   String
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title      String
  type       String         // "video" | "quiz" | "document"
  contentUrl String?
  content    String?
  duration   Int?
  order      Int            @default(0)
  questions  QuizQuestion[]
  createdAt  DateTime       @default(now())
}

model QuizQuestion {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question String
  options  String // JSON array stored as string
  correct  Int
  order    Int    @default(0)
}

model CourseProgress {
  id          String    @id @default(cuid())
  driverId    String
  driver      Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  score       Float?
  certified   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([driverId, courseId])
}

// ─── SPRINT 5 — SCORE IA ─────────────────────────────────────────────────────

model GuideLesson {
  id        String   @id @default(cuid())
  moduleKey String
  title     String
  stepOrder Int
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())
}

model GuideFeedback {
  id        String   @id @default(cuid())
  moduleKey String
  helpful   Boolean
  createdAt DateTime @default(now())
}

model ReliabilityScore {
  id              String   @id @default(cuid())
  driverName      String
  deliveryRate    Float    @default(0)
  academyScore    Float    @default(0)
  noShowRate      Float    @default(0)
  score           Float    @default(0)
  // score = deliveryRate*0.4 + academyScore*0.3 + (100-noShowRate)*0.3
  recommendation  String?
  calculatedAt    DateTime @default(now())

  @@index([driverName])
  @@index([calculatedAt])
  reportId     String?
  coefficients String?
  ordersCount  Int?
  scoreVersion Int     @default(1)
}

// ─── SPRINT 7 — ALERTES PRÉDICTIVES + SLACK ───────────────────────────────────

model DeliveryAlert {
  id           String    @id @default(cuid())
  orderId      String?
  reportId     String?
  driverName   String?
  mode         String    @default("standard") // "standard" | "express"
  level        Int       @default(1)           // 1=warning 2=danger 3=critical
  type         String    // "delay_risk" | "delay_confirmed" | "gps_blocked" | "predictive"
  message      String
  channel      String    @default("inapp")
  acknowledged Boolean   @default(false)
  triggeredAt  DateTime  @default(now())
  ackAt        DateTime?
  ackBy        String?
  createdAt    DateTime  @default(now())

  @@index([acknowledged])
  @@index([level])
  @@index([createdAt])
}

model SlackConfig {
  id         String   @id @default(cuid())
  webhookUrl String
  channel    String   @default("#alertes-livraison")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── SPRINT 8 — RÉMUNÉRATION LIVREURS ────────────────────────────────────────

model PayConfig {
  id          String   @id @default(cuid())
  mode        String   @default("standard") // "standard" | "express"
  label       String   @default("Standard")
  baseRate    Float    @default(15)  // MAD par livraison réussie
  bonusRate   Float    @default(5)   // MAD bonus livraison dans les délais
  penaltyRate Float    @default(5)   // MAD pénalité par NO_SHOW
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([mode])
}

model DriverPay {
  id           String   @id @default(cuid())
  reportId     String
  driverName   String
  mode         String   @default("standard")
  total        Int      @default(0)  // total commandes assignées
  deliveries   Int      @default(0)  // livraisons réussies
  onTime       Int      @default(0)  // dans les délais
  noShows      Int      @default(0)  // NO_SHOW
  grossPay     Float    @default(0)  // deliveries × baseRate
  bonus        Float    @default(0)  // onTime × bonusRate
  penalty      Float    @default(0)  // noShows × penaltyRate
  netPay       Float    @default(0)  // grossPay + bonus - penalty
  calculatedAt DateTime @default(now())

  @@unique([reportId, driverName, mode])
  @@index([reportId])
  @@index([driverName])
}

// ─── SPRINT 9 — DISPATCH + POINTAGE + SUPPORT ────────────────────────────────

model DriverAttendance {
  id         String    @id @default(cuid())
  driverName String
  date       DateTime  // date du jour (minuit UTC)
  hub        String?
  checkIn    DateTime?
  checkOut   DateTime?
  status     String    @default("present") // "present"|"absent"|"late"|"leave"
  role       String    @default("LIVREUR") // "LIVREUR" | "PICKER" — Sprint 16
  qrScanId   String?   // audit — QR token used for this check — Sprint 16
  scannedBy  String?   // référent qui a scanné le QR — Sprint 16
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([driverName, date])
  @@index([date])
  @@index([driverName])
  workedMinutes Int?
  lateMinutes   Int?
  plannedDepart String?
}

model SupportTicket {
  id          String    @id @default(cuid())
  reference   String    @unique // SUP-0001
  category    String    // "livraison_manquee"|"retard"|"reclamation_cod"|"mauvais_service"|"autre"
  priority    String    @default("normale") // "urgent"|"haute"|"normale"|"basse"
  status      String    @default("ouvert")  // "ouvert"|"en_cours"|"resolu"|"ferme"
  subject     String
  description String
  clientName  String?
  clientPhone String?
  orderRef    String?
  assignedTo  String?
  resolvedAt          DateTime?
  slaBreached         Boolean   @default(false)
  satisfactionScore   Int?
  satisfactionComment String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

// ─── SPRINT 10 — SHIFTS & PLANNING ──────────────────────────────────────────

model ShiftSlot {
  id          String            @id @default(cuid())
  tenantId    String?
  zone        String
  date        DateTime          // date du créneau (minuit UTC)
  startTime   String            // "08:00"
  endTime     String            // "14:00"
  maxDrivers  Int               @default(5)
  minDrivers  Int               @default(2)
  premiumOnly Boolean           @default(false) // is_active requis si true (R9)
  assignments ShiftAssignment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([date])
  @@index([zone])
  @@index([tenantId])
}

model ShiftAssignment {
  id         String    @id @default(cuid())
  slotId     String
  slot       ShiftSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  driverName String
  scoreIA    Float?
  priority   Boolean   @default(false) // true si scoreIA >= 80
  status     String    @default("assigned") // "assigned" | "confirmed" | "no_show"
  createdAt  DateTime  @default(now())

  @@unique([slotId, driverName])
  @@index([slotId])
  @@index([driverName])
}

// ─── SPRINT 9b — MULTI-TENANT + RÔLES + AUTH ─────────────────────────────────

model Tenant {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  logoUrl             String?
  primaryColor        String    @default("#2563eb")
  plan                String    @default("basic") // "basic" | "pro" | "enterprise"
  active              Boolean   @default(true)
  scoreCoeffDelivery  Float     @default(0.4)
  scoreCoeffAcademy   Float     @default(0.3)
  scoreCoeffNoShow    Float     @default(0.3)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  users               User[]

  @@index([slug])
  @@index([active])
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String    // PBKDF2 hash : "salt:hash"
  name      String?
  role      String    @default("VIEWER") // "SUPER_ADMIN" | "ADMIN" | "MANAGER" | "VIEWER"
  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  sessions  Session[]

  @@index([email])
  @@index([tenantId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// ─── SPRINT 11 — N8N + WHATSAPP ───────────────────────────────────────────────

model N8NConfig {
  id          String   @id @default(cuid())
  name        String
  webhookUrl  String
  eventType   String   // "report_ready" | "alert_critical" | "driver_onboarded" | "shift_assigned" | "*"
  secret      String?  // optional HMAC secret for signature verification
  active      Boolean  @default(true)
  lastTriggeredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventType])
  @@index([active])
}

// ─── SPRINT 15 — N8N LOGS ─────────────────────────────────────────────────────

model N8NLog {
  id           String   @id @default(cuid())
  configId     String?
  eventType    String
  status       String   // "success" | "error"
  responseCode Int?
  payload      String?  // stringified JSON, max 500 chars
  error        String?
  createdAt    DateTime @default(now())

  @@index([configId])
  @@index([eventType])
  @@index([createdAt])
}

// ─── SPRINT 17 — NOTIFICATIONS (n8n hub) ─────────────────────────────────────

model NotificationLog {
  id          String   @id @default(cuid())
  kind        String   // "report" | "alert"
  event       String   // "report_ready" | "alert" | "notification_retry"
  title       String
  summary     String
  recipients  String?  // comma-joined emails / phones
  channels    String   @default("[]") // JSON array of requested channels ["email","slack","whatsapp"]
  results     String?  // JSON array: [{ channel, status, sentTo?, error?, at }]
  status      String   @default("pending") // pending | sent_to_n8n | delivered | partial | failed
  mode        String   @default("direct")  // "direct" | "n8n"
  pdfFilename String?
  reportId    String?
  alertLevel  Int?
  payloadJson String?  // stringified retry payload (no PDF), max ~4000 chars
  tenantId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId])
}

// ─── SPRINT 16 — DUAL MODE : EXPRESS ─────────────────────────────────────────

model ExpressReport {
  id          String         @id @default(cuid())
  filename    String
  uploadedAt  DateTime       @default(now())
  totalRows   Int            @default(0)
  storeType   String?        // "supermarket" | "hypermarket"
  tenantId    String?
  orders      ExpressOrder[]

  @@index([tenantId])
}

model ExpressOrder {
  id              String        @id @default(cuid())
  reportId        String
  report          ExpressReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  orderId         String
  driverName      String
  pickerId        String?
  hubName         String?
  zone            String?
  status          String        // "DELIVERED" | "CANCELLED" | "PENDING" | "PICKED"
  pickingStatus   String        @default("a_picker") // "a_picker" | "en_cours" | "pret" | "recupere"
  pickingStartAt  DateTime?
  pickingEndAt    DateTime?
  deliveryStartAt DateTime?
  deliveryEndAt   DateTime?
  slaTarget       Int           @default(45) // 45 ou 80 (minutes)
  slaRespected    Boolean?
  customerAddress String?
  storeType       String?       // "supermarket" | "hypermarket"
  createdAt       DateTime      @default(now())
  tenantId        String?

  @@index([reportId])
  @@index([driverName])
  @@index([pickerId])
  @@index([tenantId])
}

// ─── MODULE 0 — SHIPINFY OPÉRATIONNEL : socle temps réel (sync back-office) ───
// Source de vérité opérationnelle : alimentée par lib/ops-sync.ts (mock-backoffice aujourd'hui,
// API back-office Shipinfy demain). Indépendante de DeliveryReport / DeliveryOrder (import Excel).

model OpsHub {
  id        String   @id @default(cuid())
  tenantId  String?
  code      String   @unique // "CAS-MM"
  name      String
  city      String   // CASABLANCA | MARRAKECH | AGADIR
  lat       Float?
  lng       Float?
  active    Boolean  @default(true)
  drivers   OpsDriver[]
  vehicles  OpsVehicle[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([tenantId])
}

model OpsVehicle {
  id              String    @id @default(cuid())
  tenantId        String?
  plate           String    @unique
  type            String    // moto | utilitaire | van
  fuelType        String    @default("diesel")
  capacityKg      Float?
  consumptionL100 Float?
  odometerKm      Float     @default(0)
  status          String    @default("active") // active | maintenance | out_of_service
  hubId           String?
  hub             OpsHub?   @relation(fields: [hubId], references: [id], onDelete: SetNull)
  crew            OpsDriver[] // équipe : 1 chauffeur + 1 helper
  brand           String?
  model           String?
  year            Int?
  registrationNo  String?
  insuranceExpiry      DateTime?
  technicalVisitExpiry DateTime?
  vignetteExpiry       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([hubId])
}

model OpsDriver {
  id            String      @id @default(cuid())
  tenantId      String?
  code          String      @unique // "D01" — = courierRef côté back-office
  firstName     String
  lastName      String
  phone         String?
  hubId         String?     // hub d'affectation courant (modifiable : switch de hub)
  hub           OpsHub?     @relation(fields: [hubId], references: [id], onDelete: SetNull)
  homeHubId     String?     // hub d'origine
  vehicleId     String?
  vehicle       OpsVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  status        String      @default("active") // active | off | leave
  payMode       String      @default("fixed")  // rémunération fixe journalière + bonus
  dailyRate     Float       @default(150)      // MAD / jour pointé
  bonusPerOrder Float       @default(0)
  jobType       String      @default("chauffeur") // chauffeur | helper
  cin           String?
  address       String?
  birthDate     DateTime?
  hireDate      DateTime?
  contractType  String      @default("CDD") // CDI | CDD | Prestation
  licenseNo     String?
  licenseExpiry DateTime?
  licenseCategory String?
  medicalVisitExpiry DateTime?
  onboardingStatus String   @default("actif") // prospect | formation | quiz | valide | actif | inactif
  trainingDone  Boolean     @default(true)
  quizScore     Float?
  contractGeneratedAt DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orders        OpsOrder[]

  @@index([hubId])
  @@index([tenantId])
}

model OpsOrder {
  id               String        @id @default(cuid())
  tenantId         String?
  source           String        @default("mock") // mock | shipinfy-bo
  externalId       String
  reference        String?
  shipper          String?
  hubCode          String?
  city             String?
  district         String?
  status           String        // READY_PICKUP | ASSIGNED | IN_TRANSPORT | START_DELIVERY | DELIVERED | NO_SHOW
  slotStart        DateTime
  slotEnd          DateTime
  slotLabel        String?       // "09-12"
  amount           Float?
  customerName     String?
  address          String?
  lat              Float?
  lng              Float?
  cluster          String?
  attemptCount     Int           @default(1)
  courierRef       String?       // livreur selon le back-office
  driverId         String?       // livreur selon NOTRE dispatch (prioritaire sur courierRef)
  driver           OpsDriver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  createdAtSrc     DateTime?
  assignedAt       DateTime?
  inTransportAt    DateTime?
  startDeliveryAt  DateTime?
  deliveredAt      DateTime?
  noShowAt         DateTime?
  sourceUpdatedAt  DateTime
  syncedAt         DateTime      @default(now())
  collectedAt      DateTime?     // encaissement : commande livrée dont le montant a été remis (fin de parcours)
  collectedAmount  Float?
  collectedBy      String?
  collectionMethod String?
  collectionNote   String?
  missingItems     Int?
  cancelReason     String?
  events           OpsOrderEvent[]

  @@unique([source, externalId])
  @@index([slotStart])
  @@index([hubCode, slotStart])
  @@index([status])
  @@index([driverId])
  @@index([tenantId])
  @@index([collectedAt])
  customerPhone    String?
  otpAttempts      Int           @default(0)
  otpVerifiedAt    DateTime?
  otpVerifiedBy    String?
}

model OpsOrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      OpsOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  at         DateTime // horodatage source (pas l'heure de sync)
  source     String   @default("sync") // sync | dispatch | manual
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([at])
  @@index([toStatus])
}

model OpsSyncRun {
  id          String    @id @default(cuid())
  source      String
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  fetched     Int       @default(0)
  created     Int       @default(0)
  updated     Int       @default(0)
  events      Int       @default(0)
  cursorAfter String?   // curseur "ISO|id" — le dernier run OK de la source fait foi
  ok          Boolean   @default(false)
  error       String?
  durationMs    Int?
  liveRefreshMs Int?
  pages         Int?
  rejected      Int       @default(0)

  @@index([source, startedAt])
}

// ─── MODULES 2-7 — dispatch, pointage/paie, flotte/gasoil, audit/historique ───

model OpsAuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  at        DateTime @default(now())
  actor     String?  // email / nom de l'utilisateur
  action    String   // dispatch.assign | dispatch.auto | driver.hub_switch | attendance.set | pay.config | fleet.fuel | fleet.maintenance ...
  entity    String   // order | driver | vehicle | attendance | config
  entityId  String?
  hubCode   String?
  payload   String?  // JSON
  createdAt DateTime @default(now())

  @@index([at])
  @@index([action])
  @@index([entity, entityId])
}

model OpsAttendance {
  id        String   @id @default(cuid())
  driverId  String
  date      DateTime // minuit UTC du jour local (pointage à la JOURNÉE, pas à la commande)
  status    String   @default("present") // present | late | absent | leave
  checkIn   DateTime?
  checkOut  DateTime?
  hubCode   String?  // hub du jour (peut différer du hub d'origine après un switch)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([driverId, date])
  @@index([date])
  @@index([driverId])
}

model OpsPayConfig {
  id             String   @id @default("default")
  dailyRate      Float    @default(150) // MAD / jour pointé (mode Standard = fixe)
  bonusThreshold Int      @default(10)  // bonus au-delà de N commandes livrées dans la journée
  bonusPerOrder  Float    @default(5)   // MAD par commande au-delà du seuil
  onTimeBonus    Float    @default(0)   // MAD par commande livrée dans le créneau
  noShowPenalty  Float    @default(0)   // MAD retenus par NO_SHOW
  latePenalty    Float    @default(0)   // MAD retenus par livraison hors créneau
  helperDailyRate Float   @default(100) // MAD / jour pointé pour un helper
  paidLeave      Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model OpsFuelLog {
  id         String   @id @default(cuid())
  vehicleId  String
  date       DateTime
  liters     Float
  amountMad  Float
  odometerKm Float?
  station    String?
  notes      String?
  missionId  String?
  createdAt  DateTime @default(now())

  @@index([vehicleId, date])
}

model OpsMaintenance {
  id          String    @id @default(cuid())
  vehicleId   String
  date        DateTime
  type        String    // vidange | pneus | freins | revision | reparation | assurance | visite_technique | autre
  costMad     Float     @default(0)
  odometerKm  Float?
  notes       String?
  nextDueKm   Float?
  nextDueDate DateTime?
  missionId   String?
  status      String    @default("done") // done | planned
  createdAt   DateTime  @default(now())

  @@index([vehicleId, date])
}

// ─── Missions (départ / retour du véhicule dans la journée) ───
model OpsMission {
  id         String    @id @default(cuid())
  vehicleId  String
  driverCode String?
  helperCode String?
  hubCode    String?
  day        DateTime  // minuit UTC du jour local
  startAt    DateTime  // départ de la journée
  endAt      DateTime? // fin de la journée (retour au hub)
  startKm    Float?
  endKm      Float?
  status     String    @default("en_cours") // en_cours | terminee
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([vehicleId, day])
  @@index([day])
  @@index([status])
}

// ─── Notifications : canaux (Slack par équipe), règles événement × audience × canal, journal anti-doublon ───
model OpsNotifChannel {
  key        String   @id // "slack:dispatch" | "slack:managers" | "slack:rh" | "whatsapp"
  kind       String   // slack | whatsapp
  label      String
  webhookUrl String?
  active     Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

model OpsNotifRule {
  id        String   @id @default(cuid())
  event     String   // slot_at_risk | order_late | no_show | unassigned_soon | hub_saturation | doc_expiring
  audience  String   // team:dispatch | team:managers | team:rh | chauffeur | helper
  channel   String   // slack | whatsapp
  enabled   Boolean  @default(true)
  template  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([event, audience, channel])
}

model OpsNotifLog {
  id        String   @id @default(cuid())
  ruleId    String?
  event     String
  audience  String
  channel   String
  dedupeKey String   @unique
  recipient String?
  message   String
  ok        Boolean  @default(false)
  error     String?
  attempts    Int       @default(0)
  nextRetryAt DateTime?
  dead        Boolean   @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Paramètres de calcul centralisés (voir lib/ops-config.ts) : une ligne par paramètre, valeur JSON.
model OpsSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Planning journalier : une ligne par chauffeur (son coéquipier helper suit) — hub du jour, heure de départ, créneaux.
model OpsPlanDay {
  day         String    @id // YYYY-MM-DD
  status      String    @default("draft") // draft | published
  publishedAt DateTime?
  publishedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model OpsPlanLine {
  id         String    @id @default(cuid())
  day        String
  driverCode String
  hubCode    String
  departTime String    @default("08:30")
  slots      String    @default("") // "09-12,12-15"
  note       String?
  demand     String?   // JSON {slot: commandes prévues} pour le hub ce jour-là (figé à l'envoi)
  sentAt     DateTime?
  sentStatus String?
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([day, driverCode])
  @@index([day])
}

// ─── SPRINT 17 — sécurité, intégrité, quick wins ─────────────────────────────
model QrScanNonce {
  nonce      String   @id
  driverName String
  usedAt     DateTime @default(now())

  @@index([usedAt])
}

model OpsSyncReject {
  id         String   @id @default(cuid())
  source     String
  externalId String?
  reason     String
  payload    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model OpsOutbox {
  id          String    @id @default(cuid())
  kind        String    @default("assign")
  externalId  String
  courierRef  String?
  attempts    Int       @default(0)
  nextRetryAt DateTime  @default(now())
  doneAt      DateTime?
  createdAt   DateTime  @default(now())
}

model OpsSpecialDay {
  day       String   @id // YYYY-MM-DD
  label     String
  kind      String   @default("event") // ramadan | aid | payday | promo | event
  factor    Float    @default(1)
  createdAt DateTime @default(now())
}

model OpsCashClose {
  id         String   @id @default(cuid())
  day        String
  hubCode    String
  driverCode String   @default("")
  expected   Float
  declared   Float
  gap        Float
  note       String?
  closedBy   String?
  closedAt   DateTime @default(now())

  @@unique([day, hubCode, driverCode])
}

// ─── SPRINT 18 — clôture de paie ─────────────────────────────────────────────
model OpsPayRun {
  id          String    @id @default(cuid())
  period      String    @unique // YYYY-MM
  status      String    @default("draft") // draft | validated | paid
  config      String?   // JSON : barème figé (OpsPayConfig) au moment du calcul
  totals      String?   // JSON : totaux de la période
  note        String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  validatedBy String?
  validatedAt DateTime?
  paidBy      String?
  paidAt      DateTime?
  updatedAt   DateTime  @default(now()) @updatedAt
}

model OpsPayRunLine {
  id             String  @id @default(cuid())
  runId          String
  driverCode     String
  driverName     String
  jobType        String  @default("chauffeur")
  hubCode        String?
  dailyRate      Float   @default(0)
  paidDays       Float   @default(0)
  daysLate       Int     @default(0)
  daysAbsent     Int     @default(0)
  daysLeave      Int     @default(0)
  delivered      Int     @default(0)
  onTime         Int     @default(0)
  deliveredLate  Int     @default(0)
  noShow         Int     @default(0)
  bonusOrders    Int     @default(0)
  gross          Float   @default(0)
  bonus          Float   @default(0)
  deductions     Float   @default(0)
  net            Float   @default(0)
  adjustment     Float   @default(0)
  adjustmentNote String?
  final          Float   @default(0)

  @@unique([runId, driverCode])
  @@index([runId])
}

// ─── SPRINT 19 — suivi client ────────────────────────────────────────────────
model OpsDeliveryRating {
  id        String   @id @default(cuid())
  orderId   String   @unique
  score     Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model OpsCustomerNotif {
  id        String   @id @default(cuid())
  orderId   String
  kind      String
  channel   String   @default("whatsapp")
  status    String   @default("pending")
  error     String?
  createdAt DateTime @default(now())

  @@unique([orderId, kind, channel])
  @@index([createdAt])
}
